# Production URLs baked in during `vite build` on Vercel.
VITE_BACKEND_URL = "https://employee-management-software-backend.vercel.app/api"

# IMPORTANT: Socket.IO needs a persistent process. Vercel serverless functions
# cannot hold WebSocket/long-poll connections, so realtime signaling (meeting
# presence, offers/answers/ICE) will NOT work against this Vercel URL.
# Point VITE_SOCKET_URL at a long-running host (Render/Railway/EC2) that runs
# Server/index.js, otherwise audio/video/screen-share never connects.
VITE_SOCKET_URL = "https://employee-management-software-backend.vercel.app"

# TURN credentials for calls across different networks (symmetric NAT, cellular,
# corporate firewalls). STUN-only calls fail silently there. Use short-lived
# credentials minted server-side where your provider supports it.
# VITE_TURN_URL = "turn:your-turn-host:3478,turns:your-turn-host:5349"
# VITE_TURN_USERNAME = "generated-username"
# VITE_TURN_CREDENTIAL = "generated-credential"
