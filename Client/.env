# Local development URLs (change to your LAN IP like http://192.168.1.23:3000
# when testing meeting calls from a second physical device on the same network).
VITE_BACKEND_URL = "http://localhost:3000/api"
VITE_SOCKET_URL = "http://localhost:3000"

# Deployed backend (production build reads Client/.env.production instead).
# VITE_BACKEND_URL = "https://employee-management-software-backend.vercel.app/api"
# VITE_SOCKET_URL = "https://employee-management-software-backend.vercel.app"

# TURN credentials for reliable calls across different networks (symmetric NAT,
# cellular, corporate firewalls). STUN-only calls fail silently there.
# VITE_TURN_URL = "turn:your-turn-host:3478,turns:your-turn-host:5349"
# VITE_TURN_USERNAME = "generated-username"
# VITE_TURN_CREDENTIAL = "generated-credential"
